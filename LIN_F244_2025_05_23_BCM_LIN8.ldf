Node_attributes {
  RLS{
    LIN_protocol = "2.0" ;
    configured_NAD = 0x4 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = ResponseErrorStsRLS ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    configurable_frames {
      RLSCfgData = 0x1D ;
      FSdata = 0x23 ;
      ComToRLS = 0x26 ;
      RLSData = 0x29 ;
      SoSe = 0x32 ;
    }
  }
  WSM{
    LIN_protocol = "2.1" ;
    configured_NAD = 0xE ;
    initial_NAD = 0xE ;
    product_id = 0x0, 0x0, 0 ;
    response_error = COMM_ERR_LIN_WSM ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      NBCToWSM ;
      TIME_E_DATE ;
      VEHICLE_INFO ;
      WSM_STATUS ;
      WSM_STATUS_2 ;
    }
  }
  DIAG_TESTER_LIN8{
    LIN_protocol = "2.1" ;
    configured_NAD = 0x40 ;
    initial_NAD = 0x40 ;
    product_id = 0xFFF, 0xFFF, 255 ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      WSM_STATUS_2 ;
    }
  }
  WSMs{
    LIN_protocol = "2.1" ;
    configured_NAD = 0xBE ;
    initial_NAD = 0xBE ;
    product_id = 0x0, 0x0, 1 ;
    response_error = ResponseErrorStsWSMs ;
    P2_min = 50 ms ;
    ST_min = 0 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
  }
}

Schedule_tables {
 Init {
    MasterReq delay 10 ms ;
    SlaveResp delay 10 ms ;
  }
 Key_ON_OFF_WSM_RLS_Active {
    ComToRLS delay 10 ms ;
    RLSCfgData delay 10 ms ;
    RLSData delay 10 ms ;
    NBCToWSM delay 10 ms ;
    SoSe delay 10 ms ;
    FSdata delay 10 ms ;
    WSM_STATUS delay 10 ms ;
    WSM_STATUS_2 delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
}


