Node_attributes {
  ASU {
    LIN_protocol = "2.0";
    configured_NAD = 0x2;
    product_id = 0x0000, 0x0000, 0x00;
    response_error = ResponseErrorStsASU;
    P2_min = 50 ms;
    configurable_frames { 
      Command_ASU=0x0;
      Heart_Beat_ASU=0x0;
      Heart_Beat_Feedback_ASU=0x0;
      Ins_Disins=0x0;
      Status_ASU=0x0;
      Status_BCM=0x0;
    }
  }
  DIAG_TESTER_LIN2 {
    LIN_protocol = "1.3";
    configured_NAD = 0x40;
  }
}

Schedule_tables {
  Operating_Armed {
    Status_BCM delay 10 ms;
    MasterReq delay 20 ms;
    Heart_Beat_ASU delay 10 ms;
    Status_ASU delay 30 ms;
    Heart_Beat_Feedback_ASU delay 10 ms;
    SlaveResp delay 20 ms;
  }
  Operating_Armed_InsDisins {
    Status_BCM delay 10 ms;
    MasterReq delay 20 ms;
    Heart_Beat_ASU delay 10 ms;
    Status_ASU delay 30 ms;
    Heart_Beat_Feedback_ASU delay 10 ms;
    Ins_Disins delay 20 ms;
  }
  Operating_Armed_CommandAsu {
    Status_BCM delay 10 ms;
    Command_ASU delay 20 ms;
    Heart_Beat_ASU delay 10 ms;
    Status_ASU delay 30 ms;
    Heart_Beat_Feedback_ASU delay 10 ms;
    SlaveResp delay 20 ms;
  }
  Operating_Disarmed {
    Status_BCM delay 10 ms;
    MasterReq delay 20 ms;
    Status_ASU delay 30 ms;
    SlaveResp delay 20 ms;
  }
  Operating_Disarmed_InsDisins {
    Status_BCM delay 10 ms;
    Ins_Disins delay 20 ms;
    Status_ASU delay 30 ms;
    SlaveResp delay 20 ms;
  }
  Sleep_Armed {
    Heart_Beat_ASU delay 10 ms;
    Heart_Beat_Feedback_ASU delay 10 ms;
  }
  Init {
    MasterReq delay 10 ms;
    SlaveResp delay 10 ms;
  }
}

