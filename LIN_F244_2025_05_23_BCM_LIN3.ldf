    N_As_timeout = 1000 ms;
    N_Cr_timeout = 1000 ms;
    configurable_frames { 
      ALMtoNBC;
      NBCtoLCC_Ceiling_Mng;
    }
  }
  LCC {
    LIN_protocol = "2.1";
    configured_NAD = 0x6A;
    initial_NAD = 0x6A;
    product_id = 0x0000, 0x0000, 0x00;
    response_error = ResponseErrorCeiling;
