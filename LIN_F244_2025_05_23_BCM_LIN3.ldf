Node_attributes {
  DIAG_TESTER_LIN3 {
    LIN_protocol = "1.3";
    configured_NAD = 0x40;
  }
  ALM {
    LIN_protocol = "2.1";
    configured_NAD = 0x5;
    initial_NAD = 0x5;
    product_id = 0x0000, 0x0000, 0x00;
    response_error = ALMAmbientLightResponseError;
