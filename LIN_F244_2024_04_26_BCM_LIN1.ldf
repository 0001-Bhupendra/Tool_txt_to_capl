Node_attributes {
  MCL {
    LIN_protocol = "1.3";
    configured_NAD = 0x3;
  }
  WLML {
    LIN_protocol = "2.2";
    configured_NAD = 0x71;
    initial_NAD = 0x71;
    product_id = 0x0000, 0x0000, 0x00;
    response_error = ResponseError_WLML;
    P2_min = 50 ms;
    configurable_frames { 
      NBCToWLMCommand;
      WLMLToNBCFeedback;
    }
  }
  DIAG_TESTER_LIN1 {
    LIN_protocol = "1.3";
    configured_NAD = 0x40;
  }
}

Schedule_tables {
  Init {
    SlaveResp delay 10 ms;
    MasterReq delay 10 ms;
  }
  MCL {
    NBC_MEM_POS_EXMI_LIN delay 10 ms;
    Fdbk_Pos_Exmi_LH delay 10 ms;
    Err_LH_Exmi_Sts delay 10 ms;
    NBC_CNTRL_EXMI_LIN delay 10 ms;
    Err_Warn_LH_Exmi_LIN delay 10 ms;
  }
  WLML_MCL {
    NBC_MEM_POS_EXMI_LIN delay 10 ms;
    Fdbk_Pos_Exmi_LH delay 10 ms;
    Err_LH_Exmi_Sts delay 10 ms;
    NBCToWLMCommand delay 10 ms;
    NBC_CNTRL_EXMI_LIN delay 10 ms;
    Err_Warn_LH_Exmi_LIN delay 10 ms;
    WLMLToNBCFeedback delay 10 ms;
  }
  WLML {
    NBCToWLMCommand delay 10 ms;
    WLMLToNBCFeedback delay 10 ms;
  }
}

