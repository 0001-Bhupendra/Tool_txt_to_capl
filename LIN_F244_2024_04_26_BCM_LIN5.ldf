Node_attributes {
  WLRL {
    LIN_protocol = "2.2";
    configured_NAD = 0x76;
    initial_NAD = 0x76;
    product_id = 0x0000, 0x0001, 0x00;
    response_error = ResponseErrorWMRL;
    P2_min = 50 ms;
    ST_min = 10 ms;
    N_As_timeout = 1000 ms;
    N_Cr_timeout = 1000 ms;
    configurable_frames { 
      NBCToWMRCommand;
      WMRLToNBCFeedback;
    }
  }
  DIAG_TESTER_LIN5 {
    LIN_protocol = "1.3";
    configured_NAD = 0x40;
  }
}

Schedule_tables {
  WMRL_KeyOFF {
    NBCToWMRCommand delay 10 ms;
    WMRLToNBCFeedback delay 10 ms;
  }
  Init {
    SlaveResp delay 10 ms;
    MasterReq delay 10 ms;
  }
  KeyON_1 {
    NBCToWMRCommand delay 10 ms;
    WMRLToNBCFeedback delay 10 ms;
  }
}

