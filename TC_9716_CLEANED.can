///////////////////////////////////////////////////////////////////////////////
// CAPL Test Module
// Test Case ID: 9716
// Test Case: TC_F027_LCU_Feedback_Plausibility_RightPL_Key_ON
// Component: rbg.Ferrari_BCM_Testing_F027
// Description: Checking plausibility and DTC for Right PL feedback signal
//
// This module implements automated test execution for DTC B105564 handling
// (Right Position Feedback - Signal plausibility failure)
///////////////////////////////////////////////////////////////////////////////

// Include necessary headers and libraries
#include "stdlib.can"

///////////////////////////////////////////////////////////////////////////////
// Pre-Condition Setup
///////////////////////////////////////////////////////////////////////////////

void setup_pre_conditions()
{
  // Set environment to Night mode
  vtsStimulateSignal("sys_F858_NBC_Night_DaySts_for_IE", 0);  // Night
  
  // Set key to ON
  vtsStimulateSignal("sys_F040_KeySts", 4);  // ON(4)
  
  // Initialize all feedback signals to 0
  write("si_sys_F027_LCU_Left_DRL_Feedback", 0);
  write("si_sys_F027_LCU_Right_DRL_Feedback", 0);
  write("si_sys_F027_LCU_Left_PL_Feedback", 0);
  write("si_sys_F027_LCU_Right_PL_Feedback", 0);

  // Allow system to settle
  wait(100); // ms
}

///////////////////////////////////////////////////////////////////////////////
// Test Stimulation Steps
///////////////////////////////////////////////////////////////////////////////

// Stimulation-1: "Activation of Position Lights"
// Activate position lights and verify all outputs are on
void stimulation_step_1()
{
  write("Step 1: Activating Position Lights...");
  
  // Actions
  write("Proxy_write_LCU", 1);
  vtsStimulateSignal("sys_F858_NBC_Night_DaySts_for_IE", 0);  // Night
  write("si_sys_F027_LCU_Left_PL_Feedback", 1);
  write("si_sys_F027_LCU_Right_PL_Feedback", 1);
  
  wait(100); // Allow system to respond
  
  // Expected Results: All lights should be on, no DTC
  if (!checkSignalValue("XCP_sys_F247_FrontPosLightCmd", 1))
  {
    setResult(FAIL, "XCP_sys_F247_FrontPosLightCmd should be 1");
  }
  if (!checkSignalValue("XCP_sys_F247_RearPositionCmd", 1))
  {
    setResult(FAIL, "XCP_sys_F247_RearPositionCmd should be 1");
  }
  if (!checkSignalValue("so_sys_F027_NBC_LeftPL", 1))
  {
    setResult(FAIL, "so_sys_F027_NBC_LeftPL should be 1");
  }
  if (!checkSignalValue("so_sys_F027_NBC_RightPL", 1))
  {
    setResult(FAIL, "so_sys_F027_NBC_RightPL should be 1");
  }
  if (!checkSignalValue("so_sys_F027_NBC_LeftRearPositionLight", 100))
  {
    setResult(FAIL, "so_sys_F027_NBC_LeftRearPositionLight should be 100");
  }
  if (!checkSignalValue("so_sys_F027_NBC_RightRearPositionLight", 100))
  {
    setResult(FAIL, "so_sys_F027_NBC_RightRearPositionLight should be 100");
  }
  if (!checkNoActiveDTC())
  {
    setResult(FAIL, "No DTC should be active in Step 1");
  }
}

// Stimulation-2: "Set error"
// Set Right PL feedback to 0 (simulating open circuit/plausibility error)
void stimulation_step_2()
{
  write("Step 2: Setting Right PL error (feedback = 0)...");
  
  // Actions: Create error by setting Right PL feedback to 0
  write("si_sys_F027_LCU_Right_PL_Feedback", 0);
  
  wait(100); // Wait for DTC maturation (NOTE: Maturation time is 0.3s, should wait longer)
  wait(200); // Additional wait to ensure maturation
  
  // Expected Results: DTC B105564 should be active
  if (!checkActiveDTC("B105564"))
  {
    setResult(FAIL, "DTC B105564 should be active after Right PL feedback error");
  }
}

// Stimulation-3: "Reset Error"
// Reset Right PL feedback back to normal and verify DTC becomes passive
void stimulation_step_3()
{
  write("Step 3: Resetting Right PL error...");
  
  // Actions: Reset feedback to normal
  write("si_sys_F027_LCU_Right_PL_Feedback", 1);
  
  // Wait for DTC de-maturation (0.3 seconds)
  wait(300); // 300ms = 0.3s
  
  // Expected Results: DTC should become passive
  if (!checkPassiveDTC("B105564"))
  {
    setResult(FAIL, "DTC B105564 should be passive after error reset");
  }
}

// Stimulation-4: "Clear DTC"
// Clear all DTCs from the system
void stimulation_step_4()
{
  write("Step 4: Clearing all DTCs...");
  
  // Actions: Clear DTCs
  clearAllDTCs();
  
  wait(100);
  
  // Expected Results: No DTC Present
  if (!checkNoActiveDTC())
  {
    setResult(FAIL, "All DTCs should be cleared");
  }
}

// Stimulation-5: "AutoNight to Manual Night"
// Toggle low beam button and verify position lights turn off, DTC becomes active again
void stimulation_step_5()
{
  write("Step 5: Toggle low beam button (AutoNight to Manual Night)...");
  
  // Actions: Toggle low beam button (0->1->0 transition)
  write("si_sys_LCC_LowBeam_Button", 1);
  wait(50);
  write("si_sys_LCC_LowBeam_Button", 0);
  
  wait(300); // Wait 0.3s
  
  // Expected Results: Front position lights off, rear stays on, DTC active
  if (!checkSignalValue("XCP_sys_F247_FrontPosLightCmd", 0))
  {
    setResult(FAIL, "XCP_sys_F247_FrontPosLightCmd should be 0 (lights off)");
  }
  if (!checkSignalValue("XCP_sys_F247_RearPositionCmd", 1))
  {
    setResult(FAIL, "XCP_sys_F247_RearPositionCmd should remain 1");
  }
  if (!checkSignalValue("so_sys_F027_NBC_LeftPL", 0))
  {
    setResult(FAIL, "so_sys_F027_NBC_LeftPL should be 0 (lights off)");
  }
  if (!checkSignalValue("so_sys_F027_NBC_RightPL", 0))
  {
    setResult(FAIL, "so_sys_F027_NBC_RightPL should be 0 (lights off)");
  }
  if (!checkActiveDTC("B105564"))
  {
    setResult(FAIL, "DTC B105564 should be active");
  }
}

// Stimulation-6: "Reset Error"
// Set Right PL feedback to 0 again to trigger DTC
void stimulation_step_6()
{
  write("Step 6: Resetting Right PL error...");
  
  // Actions: Set Right PL feedback to 0
  write("si_sys_F027_LCU_Right_PL_Feedback", 0);
  
  wait(300); // Wait 0.3s for de-maturation
  
  // Expected Results: DTC should become passive
  if (!checkPassiveDTC("B105564"))
  {
    setResult(FAIL, "DTC B105564 should be passive after error reset");
  }
}

// Stimulation-7: "Clear DTC"
// Clear all DTCs again
void stimulation_step_7()
{
  write("Step 7: Clearing all DTCs...");
  
  // Actions: Clear DTCs
  clearAllDTCs();
  
  wait(100);
  
  // Expected Results: No DTC Present
  if (!checkNoActiveDTC())
  {
    setResult(FAIL, "All DTCs should be cleared");
  }
}

///////////////////////////////////////////////////////////////////////////////
// Post-Condition Cleanup
///////////////////////////////////////////////////////////////////////////////

void cleanup_post_conditions()
{
  // Reset all feedback signals to 0
  write("si_sys_F027_LCU_Left_DRL_Feedback", 0);
  write("si_sys_F027_LCU_Right_DRL_Feedback", 0);
  write("si_sys_F027_LCU_Left_PL_Feedback", 0);
  write("si_sys_F027_LCU_Right_PL_Feedback", 0);
  
  // Set key to STOP
  vtsStimulateSignal("sys_F040_KeySts", 1);  // STOP(1)
  
  wait(100); // ms
}

