Node_attributes {
  NVD{
    LIN_protocol = "2.2" ;
    configured_NAD = 0xD2 ;
    initial_NAD = 0xD2 ;
    product_id = 0x0, 0x0, 0 ;
    response_error = ResponseErrorNVD ;
    P2_min = 50 ms ;
    ST_min = 10 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      NBCToNVDCommand ;
      NVD_Status ;
    }
  }
  DIAG_TESTER_LIN7{
    LIN_protocol = "1.3" ;
    configured_NAD = 0x40 ;
  }
  MJC{
    LIN_protocol = "2.2" ;
    configured_NAD = 0x10 ;
    initial_NAD = 0x10 ;
    product_id = 0x0, 0x1, 0 ;
    response_error = ResponseErrorMJC ;
    P2_min = 50 ms ;
    ST_min = 10 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      MJC_Status ;
      NBCToMJC_Command ;
      TIME_E_DATE ;
      VEHICLE_INFO ;
    }
  }
}

Schedule_tables {
 NVD_Complete {
    NBCToNVDCommand delay 10 ms ;
    NVD_Status delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 INIT {
    SlaveResp delay 10 ms ;
    MasterReq delay 10 ms ;
  }
 Functional_MJC {
    NBCToMJC_Command delay 10 ms ;
    MJC_Status delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 Functional_MJC_NVD {
    NBCToMJC_Command delay 10 ms ;
    MJC_Status delay 10 ms ;
    NBCToNVDCommand delay 10 ms ;
    NVD_Status delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
}


