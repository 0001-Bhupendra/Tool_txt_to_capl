Node_attributes {
  WLRR{
    LIN_protocol = "2.2" ;
    configured_NAD = 0x77 ;
    initial_NAD = 0x77 ;
    product_id = 0x0, 0x1, 0 ;
    response_error = ResponseErrorWMRR ;
    P2_min = 50 ms ;
    ST_min = 10 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      NBCToWMRCommand ;
      WMRRToNBCFeedback ;
    }
  }
  DIAG_TESTER_LIN6{
    LIN_protocol = "1.3" ;
    configured_NAD = 0x40 ;
  }
  NCF{
    LIN_protocol = "2.2" ;
    configured_NAD = 0xE0 ;
    initial_NAD = 0xE0 ;
    product_id = 0x0, 0x0, 1 ;
    response_error = ResponseErrorNCF ;
    P2_min = 50 ms ;
    ST_min = 10 ms ;
    N_As_timeout = 1000 ms ;
    N_Cr_timeout = 1000 ms ;
    configurable_frames {
      NBCtoNCF ;
      NCFtoNBC ;
      TIME_E_DATE ;
      VEHICLE_INFO ;
    }
  }
}

Schedule_tables {
 Init {
    SlaveResp delay 10 ms ;
    MasterReq delay 10 ms ;
  }
 KeyON_1 {
    NBCToWMRCommand delay 10 ms ;
    WMRRToNBCFeedback delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 WMRR_KeyOFF {
    NBCToWMRCommand delay 10 ms ;
    WMRRToNBCFeedback delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 WMRR_NCF_KeyON_1 {
    NBCToWMRCommand delay 10 ms ;
    WMRRToNBCFeedback delay 10 ms ;
    NBCtoNCF delay 10 ms ;
    NCFtoNBC delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 WMRR_NCF_KeyOFF {
    NBCToWMRCommand delay 10 ms ;
    WMRRToNBCFeedback delay 10 ms ;
    NBCtoNCF delay 10 ms ;
    NCFtoNBC delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
 Functional_NCF_ {
    NBCtoNCF delay 10 ms ;
    NCFtoNBC delay 10 ms ;
    TIME_E_DATE delay 10 ms ;
    VEHICLE_INFO delay 10 ms ;
  }
}


